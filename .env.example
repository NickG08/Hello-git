# Пример: строка подключения (замени на свою локальную при работе)
DB_URL=sqlite:///./local.db

# --- KZ Bond Monitor ---
# База для снапшотов облигаций. По умолчанию (если не задано) - SQLite
# в data/kzbonds.db, ничего дополнительно поднимать не нужно.
# Для Yandex Managed PostgreSQL: postgresql+psycopg2://user:pass@host:6432/dbname
# DB_URL=sqlite:///./data/kzbonds.db

# Как часто фоновый scheduler (docker/scheduler_loop.py) обновляет данные, часов
KZBONDS_PIPELINE_INTERVAL_HOURS=6

# Сколько часов живёт кэш характеристик KASE / сколько дней - профилей AIX
KASE_CACHE_HOURS=24
AIX_CACHE_DAYS=7

KZBONDS_MAX_CONCURRENT_REQUESTS=15
KZBONDS_REQUEST_TIMEOUT=20
